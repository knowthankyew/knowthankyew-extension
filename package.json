{
  "name": "knowthankyew-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-egress, client-side browser reality engine detecting predatory subscription traps, arbitration waivers, and dark patterns in real-time",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "npm run build && (cd dist && zip -r ../knowthankyew-extension-v1.0.0.zip .) && shasum -a 256 knowthankyew-extension-v1.0.0.zip > SHA256SUMS",
    "build:assets": "node scripts/render-store-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "python3 -m http.server 3000 --directory tests"
  },
  "dependencies": {
    "@knowthankyew/privacy-telemetry": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/safe-regex": "^1.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.11.0",
    "safe-regex": "^2.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
